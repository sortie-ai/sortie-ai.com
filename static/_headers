# `immutable` below is safe only because Hugo fingerprints every file under
# those paths. Never add a path Hugo does not fingerprint: a stable filename
# under a year-long cache strands the edit with no visible symptom.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Hugo emits this as text/plain so it lands at /llms.txt, not /llms.md. The
# real type is set here. noindex: it duplicates the page for a different reader.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

# Deliberately not immutable: the social card's filename is stable because
# scrapers and published links point at it.
/img/*
  Cache-Control: public, max-age=604800
